{
    "name": "amashukov/eth-rpc-client-php",
    "description": "Ethereum JSON-RPC client in pure PHP — raw eth_* mirror (EthRpcClient) + ethers.js v6-flavoured facade (JsonRpcProvider) over any PSR-18 client. Typed Value Objects (transaction + receipt bundle, block, fee data, fee history, logs), bigint-safe hex/decimal helpers.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/AndreyMashukov/eth-rpc-client-php",
    "keywords": ["ethereum", "evm", "json-rpc", "ethers", "web3", "psr-18", "blockchain", "eip-1559", "eth-rpc", "smart-contract", "erc20", "wei", "php"],
    "support": {
        "issues": "https://github.com/AndreyMashukov/eth-rpc-client-php/issues",
        "source": "https://github.com/AndreyMashukov/eth-rpc-client-php"
    },
    "authors": [
        {
            "name": "Andrei Mashukov",
            "email": "a.mashukoff@gmail.com",
            "homepage": "https://github.com/AndreyMashukov"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-bcmath": "*",
        "ext-gmp": "*",
        "amashukov/abi-encoder-php": "^0.1.0",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "amashukov/http-client-php": "^0.1.0",
        "amashukov/rector-php-rules": "^0.1.0",
        "friendsofphp/php-cs-fixer": "^3.50",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0"
    },
    "suggest": {
        "amashukov/http-client-php": "PSR-18 cURL client + retry/header-injection middleware ready to drive this RPC client.",
        "amashukov/eip1559-tx-signer-php": "Offline EIP-1559 / EIP-155 transaction signing to feed sendTransaction()."
    },
    "autoload": {
        "psr-4": {
            "Amashukov\\EthRpc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Amashukov\\EthRpc\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run"
    }
}
